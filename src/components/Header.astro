---
import Button from "./Button.astro";
const nav = [
  { href: '#resume', label: 'Resume' },
  { href: '#projects', label: 'Projects' },
  { href: 'https://notes.xeome.dev/', label: 'Blog', external: true },
  { href: 'https://files.xeome.dev/gallery', label: 'Gallery', external: true },
];
---
<header class="top">
  <a class="name" href="#hero">Emin</a>
  <nav class="desk">
    {nav.map((item) => (
      <a href={item.href}>{item.label}{item.external && <svg viewBox="0 0 16 16"><path d="M5 11l6-6M6 5h5v5"/></svg>}</a>
    ))}
  </nav>
  <Button href="#contact" small>Contact</Button>
  <details class="menu">
    <summary aria-label="Open menu"><svg viewBox="0 0 16 16"><path d="M2.5 5h11M2.5 11h11"/></svg></summary>
    <nav class="sheet">
      {nav.map((item) => (
        <a href={item.href}>{item.label}{item.external && <svg viewBox="0 0 16 16"><path d="M5 11l6-6M6 5h5v5"/></svg>}</a>
      ))}
      <Button href="#contact">Contact</Button>
    </nav>
  </details>
</header>
