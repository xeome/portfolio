---
import Button from "./Button.astro";
export interface Props { tagline?: string }
const { tagline = "Engineering for the nanosecond." } = Astro.props as Props;
---
<div class="hero" id="hero">
  <div>
    <p class="eyebrow">Vision</p>
    <h1>{tagline}</h1>
  </div>
  <div class="lead-col">
    <p class="lede">I design and optimize low-level systems with an obsession for latency, throughput and efficiency.</p>
    <div class="actions">
      <Button href="#contact">Contact</Button>
      <Button href="#projects" variant="ghost">Projects</Button>
    </div>
  </div>
</div>
